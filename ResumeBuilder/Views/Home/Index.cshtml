@{
    ViewData["Title"] = "Resume Builder";
}

<div class="text-center mt-5">

    <h1 class="display-4 fw-bold">Resume Builder</h1>

    <p class="lead mt-3">
        Create your professional resume easily and quickly.
    </p>

    <p class="text-muted">
        Build, manage and preview your resume in one place.
    </p>

    <a asp-controller="Resume"
       asp-action="Create"
       class="btn btn-primary btn-lg mt-3">
        Create Your Resume
    </a>

</div>