@model ResumeBuilder.Models.Resume

@{
    ViewData["Title"] = "Resume Preview";
}

<style>
    body {
        background: #eeeeee;
        font-family: Arial, Helvetica, sans-serif;
        color: #222;
    }

    .resume-page {
        width: 210mm;
        min-height: 297mm;
        margin: 25px auto;
        padding: 18mm 20mm;
        background: #ffffff;
        box-shadow: 0 0 8px rgba(0,0,0,0.15);
    }

    .header {
        text-align: center;
        margin-bottom: 18px;
    }

    .name {
        font-size: 30px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 7px;
    }

    .contact {
        font-size: 11.5px;
        line-height: 1.6;
    }

        .contact a {
            color: #222;
            text-decoration: none;
        }

    .section {
        margin-top: 15px;
    }

    .section-title {
        font-size: 14px;
        font-weight: bold;
        text-transform: uppercase;
        border-bottom: 1.5px solid #222;
        padding-bottom: 4px;
        margin-bottom: 7px;
        letter-spacing: 0.3px;
    }

    .content {
        font-size: 11.5px;
        line-height: 1.5;
        white-space: pre-line;
    }

    .print-area {
        text-align: center;
        margin: 20px;
    }

    .print-btn {
        background: #222;
        color: white;
        border: none;
        padding: 10px 22px;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
    }

    @@media print {

        body * {
            visibility: hidden;
        }

        .resume-page,
        .resume-page * {
            visibility: visible;
        }

        .resume-page {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            min-height: auto;
            margin: 0;
            padding: 10mm 15mm;
            box-shadow: none;
        }

        .print-area {
            display: none;
        }
    }
</style>

<div class="print-area">
    <button class="print-btn" onclick="window.print()">
        Print / Save as PDF
    </button>
</div>

<div class="resume-page">

    <!-- HEADER -->
    <div class="header">

        <div class="name">
            @Model.FullName
        </div>

        <div class="contact">

            @if (!string.IsNullOrWhiteSpace(Model.Email))
            {
                <span>@Model.Email</span>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Phone))
            {
                <span> | @Model.Phone</span>
            }

            @if (!string.IsNullOrWhiteSpace(Model.LinkedIn))
            {
                <span> | <a href="@Model.LinkedIn">@Model.LinkedIn</a></span>
            }

            @if (!string.IsNullOrWhiteSpace(Model.GitHub))
            {
                <span> | <a href="@Model.GitHub">@Model.GitHub</a></span>
            }

        </div>

    </div>


    <!-- ABOUT ME -->
    @if (!string.IsNullOrWhiteSpace(Model.AboutMe))
    {
        <div class="section">
            <div class="section-title">About Me</div>
            <div class="content">@Model.AboutMe</div>
        </div>
    }


    <!-- EDUCATION -->
    @if (!string.IsNullOrWhiteSpace(Model.Education))
    {
        <div class="section">
            <div class="section-title">Education</div>
            <div class="content">@Model.Education</div>
        </div>
    }


    <!-- EXPERIENCE -->
    @if (!string.IsNullOrWhiteSpace(Model.Experience))
    {
        <div class="section">
            <div class="section-title">Experience</div>
            <div class="content">@Model.Experience</div>
        </div>
    }


    <!-- INTERNSHIP -->
    @if (!string.IsNullOrWhiteSpace(Model.Internship))
    {
        <div class="section">
            <div class="section-title">Internship</div>
            <div class="content">@Model.Internship</div>
        </div>
    }


    <!-- PROJECTS -->
    @if (!string.IsNullOrWhiteSpace(Model.Projects))
    {
        <div class="section">
            <div class="section-title">Projects</div>
            <div class="content">@Model.Projects</div>
        </div>
    }


    <!-- TECHNICAL SKILLS -->
    @if (!string.IsNullOrWhiteSpace(Model.TechnicalSkills))
    {
        <div class="section">
            <div class="section-title">Technical Skills</div>
            <div class="content">@Model.TechnicalSkills</div>
        </div>
    }


    <!-- SOFT SKILLS -->
    @if (!string.IsNullOrWhiteSpace(Model.SoftSkills))
    {
        <div class="section">
            <div class="section-title">Soft Skills</div>
            <div class="content">@Model.SoftSkills</div>
        </div>
    }


    <!-- CERTIFICATIONS -->
    @if (!string.IsNullOrWhiteSpace(Model.Certifications))
    {
        <div class="section">
            <div class="section-title">Certifications</div>
            <div class="content">@Model.Certifications</div>
        </div>
    }

</div>